{
  "name": "qari-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Qari Studio — a premium Quran recitation studio with live headphone monitoring and natural vocal enhancement.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run-e2e.mjs",
    "data:quran": "node scripts/build-quran-data.mjs",
    "data:verify": "node scripts/verify-quran-data.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "1.2.7",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/amiri": "5.3.0",
    "@fontsource/amiri-quran": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "fflate": "0.8.3",
    "idb": "8.0.4",
    "lucide-react": "0.577.0",
    "mp4-muxer": "5.2.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.2.0",
    "fake-indexeddb": "6.2.4",
    "playwright": "^1.63.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "3.2.7"
  }
}
